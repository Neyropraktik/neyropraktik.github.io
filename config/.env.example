# Конфигурация проекта «НейроПрактик» (курс)
# Скопировать в config/.env и заполнить. Файл в .gitignore — не коммитить!
#
# ВАЖНО: в старом .env.example был случайно закоммичен реальный токен бота.
# Токен скомпрометирован (публичная история git) — перегенерируйте его:
# @BotFather → /mybots → bot → API Token → Revoke. Новые значения — только в config/.env.

# Telegram Bot API (от @BotFather)
TELEGRAM_BOT_TOKEN=<токен от @BotFather>

# Канал для публикаций (ID вида -100...; узнать: добавить бота админом и открыть getUpdates)
TELEGRAM_CHAT_ID=<ID канала>
TELEGRAM_CHANNEL_USERNAME=neuropraktik_ru

# Ссылка на лендинг курса (заполнить после деплоя на GitHub Pages)
COURSE_URL=https://<username>.github.io/

# Boosty-канал (кнопка в главном меню бота; без ссылки кнопка не показывается)
BOOSTY_URL=https://boosty.to/neuropraktik

# Личный аккаунт менеджера без @ (кнопка «Написать менеджеру» и оплата переводом
# ведут в личку; если пусто — кнопка ведёт в канал курса)
MANAGER_USERNAME=

# Админ-бот (ID аккаунта для уведомлений о заказах; узнать у @userinfobot)
ADMIN_CHAT_ID=

# Текст для ручной оплаты (перевод) — показывается в боте как fallback
PAYMENT_MANUAL_TEXT=Оплата переводом: напишите менеджеру — пришлём реквизиты.
